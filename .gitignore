# Literature corpus
# Original PDFs and extracted text are intentionally versioned in Git for the
# active research archive. Do not add ignore rules for literature/pdfs/ or
# literature/extracted/.

# Regenerable experiment outputs
experiments/forecast_optimal_smoothing/outputs/

# Large live/frozen Monte Carlo SQLite datasets are intentionally
# NOT added to ordinary Git. Share manifests, small reports and inventory;
# if full raw SQLite is needed remotely, use explicit Git LFS storage.
# Exclusion of a file does not delete or alter its local bytes.
results/smoothness_cv/**/outcomes.sqlite
results/smoothness_cv/**/outcomes.sqlite-wal
results/smoothness_cv/**/outcomes.sqlite-shm

# Research results are intentionally not ignored by extension. If an artifact
# becomes genuinely large, preserve it with Git LFS rather than hiding it from
# version control.

# Obsidian vault: shared configuration, personal workspaces ignored
notes/.obsidian/workspace*.json
notes/.obsidian/hotkeys.json
notes/.obsidian/cache/
notes/.obsidian/plugins/
notes/.trash/
notes/_adjuntos/.DS_Store

# Standalone mathematical research wiki — shared core settings only
wiki/.obsidian/workspace*.json
wiki/.obsidian/hotkeys.json
wiki/.obsidian/cache/
wiki/.obsidian/plugins/
wiki/.obsidian/snippets/
wiki/.trash/
wiki/_adjuntos/.DS_Store
wiki/.obsidian/community-plugins.json
wiki/.obsidian/core-plugins.json
wiki/.obsidian/appearance.json

# Reproducible user-side Yahoo market return snapshot; distribution/terms may restrict redistribution
# Experiment manifests record SHA256 and source dates but do not commit raw prices/returns.
data/market_calibration/

# Large 10k-seed/d/N/noise Monte Carlo shards: retain locally and back up
# outside temporary machines. Aggregate CSV/manifest folders remain trackable.
results/pooled_loocv_smoothness/guerrero/nonzero_mean_multorder/confirmatory/d*/
results/pooled_loocv_smoothness/guerrero/nonzero_mean_multorder/preflight_*/

# Non-Gaussian mu-shift campaign: 384k pilot / 153.6M confirmatory method rows
# Only commit small audit_* aggregate CSVs and source-provenance JSON; save
# raw gzip shards outside Git and back up before retiring university machines.
results/pooled_loocv_smoothness/guerrero/nonzero_mu_nongaussian/pilot/
results/pooled_loocv_smoothness/guerrero/nonzero_mu_nongaussian/confirmatory/
results/pooled_loocv_smoothness/guerrero/nonzero_mu_nongaussian/preflight_*/

# Study K: paired Cortes-Toto criterion pilot uses original J 25 shocks.
# Leave gzip source rows locally/backed-up; commit only compact audit CSV/JSON.
results/pooled_loocv_smoothness/guerrero/cortes_criteria_replay/pilot/
results/pooled_loocv_smoothness/guerrero/cortes_criteria_replay/preflight_*/
