# Python bytecode/cache
__pycache__/
*.py[cod]

# Packaging/build artifacts
*.egg-info/
build/
dist/

# Test/tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environments and editor files
.venv/
venv/
.env
.DS_Store
.vscode/
.idea/

# LaTeX generated files
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Manuscript build products
paper/build/*
!paper/build/.gitkeep
paper_*/build/

# Local literature corpus / RAG source files
# Keep metadata, notes, and extracted text tracked; do not redistribute PDFs by default.
literature/pdfs/

# Regenerable experiment outputs
examples/outputs/
paper/outputs/*.csv
paper/outputs/*.json

# Active-paper simulation outputs (regenerable)
experiments/forecast_optimal_smoothing/outputs/
